# /etc/conf.d/noncecashd: config file for /etc/init.d/noncecashd

# Config file location
#NONCECASHD_CONFIGFILE="/etc/noncecash/noncecash.conf"

# What directory to write pidfile to?  (created and owned by $NONCECASHD_USER)
#NONCECASHD_PIDDIR="/var/run/noncecashd"

# What filename to give the pidfile
#NONCECASHD_PIDFILE="${NONCECASHD_PIDDIR}/noncecashd.pid"

# Where to write noncecashd data (be mindful that the blockchain is large)
#NONCECASHD_DATADIR="/var/lib/noncecashd"

# User and group to own noncecashd process
#NONCECASHD_USER="noncecash"
#NONCECASHD_GROUP="noncecash"

# Path to noncecashd executable
#NONCECASHD_BIN="/usr/bin/noncecashd"

# Nice value to run noncecashd under
#NONCECASHD_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
NONCECASHD_OPTS="-disablewallet"

# The timeout in seconds OpenRC will wait for noncecashd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
NONCECASHD_SIGTERM_TIMEOUT=60
