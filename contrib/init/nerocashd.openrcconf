# /etc/conf.d/nerocashd: config file for /etc/init.d/nerocashd

# Config file location
#NEROCASHD_CONFIGFILE="/etc/nerocash/nerocash.conf"

# What directory to write pidfile to?  (created and owned by $NEROCASHD_USER)
#NEROCASHD_PIDDIR="/var/run/nerocashd"

# What filename to give the pidfile
#NEROCASHD_PIDFILE="${NEROCASHD_PIDDIR}/nerocashd.pid"

# Where to write nerocashd data (be mindful that the blockchain is large)
#NEROCASHD_DATADIR="/var/lib/nerocashd"

# User and group to own nerocashd process
#NEROCASHD_USER="nerocash"
#NEROCASHD_GROUP="nerocash"

# Path to nerocashd executable
#NEROCASHD_BIN="/usr/bin/nerocashd"

# Nice value to run nerocashd under
#NEROCASHD_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
NEROCASHD_OPTS="-disablewallet"

# The timeout in seconds OpenRC will wait for nerocashd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
NEROCASHD_SIGTERM_TIMEOUT=60
